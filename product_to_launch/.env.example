# ─────────────────────────────────────────────────────────────────
# Launch Atlas · Environment variables
# Copy to `.env.local` for local builds. Set on the deploy platform
# (Cloudflare Pages / Vercel / GitHub Actions) for production builds.
# ─────────────────────────────────────────────────────────────────

# Production canonical URL. Drives metadataBase, sitemap.xml,
# robots.txt host, canonical link tags, and absolute OG image URLs.
# Trailing slash NOT required (it's stripped in lib/seo.ts).
NEXT_PUBLIC_SITE_URL=https://atlas.sunnydatascience.com

# Sub-path when deploying under a non-root URL (e.g. GitHub Pages
# at <user>.github.io/<repo>/). Leave empty for root-domain deploys.
NEXT_PUBLIC_BASE_PATH=
